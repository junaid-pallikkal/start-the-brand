# ==============================================================================
# STARTTHEBRAND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Master architectural configuration for Supabase PostgreSQL, Authentication,
# Storage Decal CDN, and Production Cloud Sync.

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT & AUTH (Required for Cloud Database & User Accounts)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Publishable Key (Safe to expose to client/browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Used for administrative operations, migrations, and backend service actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. DIRECT POSTGRESQL CONNECTION (Optional / Prisma / Migrations)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (Port 5432 or 6543 pooler)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. APPLICATION & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. AI DESIGN ENGINE PROVIDERS (Optional - Offline fallback enabled by default)
# ------------------------------------------------------------------------------
# OpenAI API Key (DALL-E 3 & GPT-4o Vision)
OPENAI_API_KEY=

# Anthropic Claude API Key (Creative Brand Director & Copywriting)
ANTHROPIC_API_KEY=

# Replicate API Token (Background removal & upscaling)
REPLICATE_API_TOKEN=
